# ==============================================================================
# DhanDrishti Environment Configuration
# ==============================================================================
# GEMINI_API_KEY: Required for AI Mentor, Document Explainer, and Myth vs. Fact Verifier.
GEMINI_API_KEY="your_actual_gemini_api_key_here"

# Optional recognized fallbacks:
# GOOGLE_API_KEY="your_actual_gemini_api_key_here"
# VITE_GEMINI_API_KEY="your_actual_gemini_api_key_here"

# APP_URL: Base URL of the deployment.
APP_URL="http://localhost:3000"

# ==============================================================================
# PRIMARY DATABASE: Supabase PostgreSQL & Supabase Auth
# ==============================================================================
# Find these in your Supabase Dashboard: Project Settings -> API & Project Settings -> Configuration -> JWT Settings
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-from-dashboard"
# Optional anon key:
SUPABASE_ANON_KEY="your-supabase-anon-key"

# ==============================================================================
# SECONDARY / FALLBACK DATABASE: Firebase Cloud Firestore
# ==============================================================================
# Find these in Firebase Console: Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
